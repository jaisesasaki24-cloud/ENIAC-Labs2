{
  "version": 2,
  "buildCommand": "cd clients/eniaclabs-frontend && npm install && npm run build",
  "outputDirectory": "clients/eniaclabs-frontend/dist/app/browser",
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Credentials", "value": "true" },
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET,OPTIONS,PATCH,DELETE,POST,PUT" },
        { "key": "Access-Control-Allow-Headers", "value": "X-CSRF-Token, X-Requested-With, Accept, Accept-Version, Content-Length, Content-MD5, Content-Type, Date, X-Api-Version, Authorization" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "http://eniaclabs.chilecentral.cloudapp.azure.com:18080/api/:path*"
    },
    {
      "source": "/realms/:path*",
      "destination": "http://eniaclabs.chilecentral.cloudapp.azure.com:18180/realms/:path*"
    },
    {
      "source": "/((?!api|realms).*|)",
      "destination": "/index.html"
    }
  ]
}
